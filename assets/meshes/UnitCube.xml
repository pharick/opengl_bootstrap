<?xml version="1.0" encoding="UTF-8" ?>
<!--
  A unit cube in gltut's mesh format, centered on the origin.

  attribute 0 = position (vec3)
  attribute 1 = color   (vec3)

  The named "position-only" VAO exists to exercise the attribute-subset
  mechanism the book uses to render the same geometry with a lit and an unlit
  program.
-->
<mesh>
	<attribute index="0" type="float" size="3">
		-0.5 -0.5  0.5
		 0.5 -0.5  0.5
		 0.5  0.5  0.5
		-0.5  0.5  0.5
		-0.5 -0.5 -0.5
		 0.5 -0.5 -0.5
		 0.5  0.5 -0.5
		-0.5  0.5 -0.5
	</attribute>

	<attribute index="1" type="float" size="3">
		0.90 0.25 0.25
		0.25 0.90 0.35
		0.30 0.45 0.95
		0.95 0.85 0.25
		0.85 0.35 0.90
		0.25 0.85 0.90
		0.95 0.55 0.20
		0.75 0.75 0.80
	</attribute>

	<vao name="position-only">
		<source attrib="0" />
	</vao>

	<indices cmd="triangles" type="ushort">
		0 1 2   0 2 3
		5 4 7   5 7 6
		4 0 3   4 3 7
		1 5 6   1 6 2
		3 2 6   3 6 7
		4 5 1   4 1 0
	</indices>
</mesh>
