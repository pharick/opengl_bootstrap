# Run with: cmake --build --preset dev --target tidy
#
# WarningsAsErrors is left empty here so an editor integration only reports.
# The dev preset turns GLCORE_TIDY on, which passes --warnings-as-errors=* so a
# new finding fails the build.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-convert-member-functions-to-static,
  -readability-identifier-length,
  -readability-magic-numbers,

# Why each of the above is off:
#
#   optin.core.EnumCastOutOfRange . gli uses a -1 sentinel outside its `target`
#                                   enum (gli/core/texture.inl). Unlike ordinary
#                                   warnings, clang-analyzer checks follow
#                                   inlined call paths into SYSTEM headers, so
#                                   marking gli SYSTEM does not silence it. The
#                                   `clang-analyzer-*` glob also enables optin.*
#                                   checks that the analyzer leaves off by
#                                   default; this is the one that bites.
#
#   avoid-do-while ................ `do { ... } while (false)` is the correct
#                                   way to write a statement-like macro; GLC_CHECK
#                                   depends on it.
#   macro-usage ................... GLC_CHECK has to be a macro to capture
#                                   __FILE__/__LINE__ and the expression text.
#   pro-bounds-constant-array-index,
#   pro-bounds-avoid-unchecked-container-access,
#   pro-bounds-pointer-arithmetic . These want gsl::at / gsl::span, which the
#                                   project does not depend on.
#   pro-type-reinterpret-cast ..... unavoidable at the GL and stb boundaries.
#   pro-type-union-access ......... glm implements vec.x/.r/.s as a union.
#   pro-type-vararg ............... ImGui::Text and friends are variadic by design.
#   include-cleaner ............... demands a direct include for every
#                                   transitively used symbol; ~280 findings, all noise.
#   no-recursion .................. the GLSL includer and the scene graph are
#                                   naturally recursive.
#   non-private-member-variables-in-classes ... config structs are plain aggregates.
#   use-trailing-return-type ...... a formatting preference, not a correctness one.
#   convert-member-functions-to-static ... GlLoader, ImGuiLayer and Window
#                                   deliberately expose instance methods so that
#                                   holding the object *is* the proof that its
#                                   precondition (GLEW loaded, ImGui context
#                                   created, window exists) has been met. Making
#                                   them static would throw that guarantee away.
#   easily-swappable-parameters,
#   avoid-magic-numbers,
#   magic-numbers,
#   identifier-length ............. too noisy for graphics code full of
#                                   x/y/z/w and literal matrix constants.

HeaderFilterRegex: 'glcore/(include|src)/.*\.hpp$'

WarningsAsErrors: ''
