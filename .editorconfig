# Baseline every editor understands, so files do not drift before clang-format
# or Prettier get a chance to run.
#
# The important one is the C++ block: .clang-format uses tabs for indentation
# (UseTab: ForIndentation), and an editor that inserts spaces on new lines would
# fight it on every keystroke.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ and GLSL. Tabs indent; clang-format still uses spaces to *align*
# continuation lines, which editorconfig has no say over.
[*.{cpp,hpp,glsl,vert,frag}]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

# Asset tooling. PEP 8 spacing, but the project's 100-column limit rather than
# PEP 8's 79, so it matches the C++ next to it.
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# The clang tooling configs are YAML.
[.clang-{format,tidy},.clangd]
indent_style = space
indent_size = 2

[*.xml]
indent_style = tab
tab_width = 4

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces are a hard line break in Markdown, so stripping them
# would silently change the rendered output.
trim_trailing_whitespace = false
