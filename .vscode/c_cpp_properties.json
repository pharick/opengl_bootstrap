{
  "version": 4,
  "configurations": [
    {
      "name": "Mac",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "compilerPath": "/usr/bin/clang++",
      "cppStandard": "c++23",
      "cStandard": "c17",
      "intelliSenseMode": "macos-clang-arm64",
      "includePath": [
        "${workspaceFolder}/glcore/include",
        "${workspaceFolder}/third_party/imgui",
        "${workspaceFolder}/third_party/imgui/backends",
        "${workspaceFolder}/third_party/gli",
        "/opt/homebrew/include"
      ],
      "defines": ["GLC_DEBUG", "GLCORE_WITH_MESH_XML", "GL_SILENCE_DEPRECATION"]
    }
  ]
}
